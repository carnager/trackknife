[Desktop Entry]
Type=Application
Name=Trackknife
Comment=MPD client and audio tagging, conversion, and library workstation
Exec=trackknife %F
Icon=multimedia-player
Categories=AudioVideo;Audio;Qt;
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/ogg;audio/x-wavpack;audio/x-musepack;audio/x-wav;
Terminal=false
